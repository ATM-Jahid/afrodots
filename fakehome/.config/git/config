[user]
	name = ATM Jahid Hasan
	email = atmjahidhasan@gmail.com

[credential]
	helper = cache

[init]
	defaultBranch = main

[core]
	pager = delta

[delta]
	dark = true
	navigate = true
	line-numbers = true

[interactive]
	diffFilter = delta --color-only

[diff]
	tool = nvimdiff

[merge]
	conflictStyle = zdiff3
	tool = nvimdiff3

[alias]
	loag = log --oneline --all --graph
